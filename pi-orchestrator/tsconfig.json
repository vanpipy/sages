{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["bun-types", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@sages/pi-subagents": ["../pi-subagents/src/index.ts"],
      "@sages/pi-subagents/*": ["../pi-subagents/src/*"]
    }
  },
  "include": ["src/**/*", "test/tools/**/*", "test/bash-guard.test.ts", "test/file-service.test.ts"],
  "exclude": ["node_modules", "dist", "../pi-subagents", "../pi", "../pi-codebase-memory", "../pi-evaluator", "test/rounds/**/*", "test/agents/**/*", "test/fixtures/**/*"]
}