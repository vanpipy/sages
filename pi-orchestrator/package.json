{
  "name": "@sages/pi-orchestrator",
  "version": "0.1.0",
  "description": "Sages orchestrator: goal_contract_create + decompose_task + brainstorming. Domain capability package, loaded by pi via standard pi.extensions.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test ./test --path-ignore-patterns dist/",
    "verify:isolation-modes": "bun run scripts/verify-isolation-modes.ts",
    "verify:soft-mode-mental-model": "bun run scripts/verify-soft-mode-mental-model.ts",
    "verify:pi-tasks-tools": "bun run scripts/verify-pi-tasks-tools.ts",
    "verify:created-by-invariant": "bun run scripts/verify-created-by-invariant.ts",
    "verify:extension-load": "bun run scripts/verify-extension-load.ts",
    "verify:pi-universe": "bun run scripts/verify-pi-universe.ts",
    "verify:all": "bun run scripts/verify-all.ts"
  },
  "keywords": [
    "pi-extension",
    "sages",
    "orchestrator",
    "brainstorming"
  ],
  "license": "MIT",
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ],
    "skills": [
      "./skills"
    ],
    "themes": []
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "dependencies": {
    "@sages/pi-subagents": "file:../pi-subagents",
    "@sages/pi-tasks": "file:../pi-tasks",
    "js-yaml": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "bun-types": "^1.3.14",
    "jiti": "^2.7.0",
    "simple-git": "^4.0.2",
    "typescript": "^6.0.3"
  }
}