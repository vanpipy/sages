{
  "name": "@sages/pi-subagents",
  "version": "0.14.2",
  "description": "Sages fork — A pi extension extension that brings smart Claude Code-style autonomous sub-agents to pi.",
  "author": "vanpipy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vanpipy/sages.git"
  },
  "homepage": "https://github.com/vanpipy/sages#readme",
  "bugs": {
    "url": "https://github.com/vanpipy/sages/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "subagent",
    "agent",
    "autonomous"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "0.81.1",
    "@earendil-works/pi-coding-agent": "0.81.1",
    "@earendil-works/pi-tui": "0.81.1"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.49",
    "croner": "^10.0.1",
    "nanoid": "^5.0.0"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run e2e --reporter=verbose",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/ test/",
    "lint:fix": "biome check --fix src/ test/",
    "profile:smoke": "SAGES_PI_PROFILE=1 timeout 7s bun run scripts/profile-smoke.ts",
    "profile:summary": "SAGES_PI_PROFILE=1 timeout 12s bun run scripts/profile-smoke.ts 2>&1 | grep -E '^profile_summary' | head -3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@types/node": "^25.5.0",
    "typescript": "^6.0.0",
    "vitest": "^4.0.18"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "video": "https://github.com/tintinweb/pi-subagents/raw/master/media/demo.mp4",
    "image": "https://github.com/tintinweb/pi-subagents/raw/master/media/screenshot.png"
  }
}
