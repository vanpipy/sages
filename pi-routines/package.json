    "nanoid": "^5.0.0",
    "typebox": "^1.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/node": "^22.0.0",
    "tsx": "^4.22.3",
    "typescript": "^5.6.0"
  }
}
