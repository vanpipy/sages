{
	"name": "@sages/pi-evaluator",
	"version": "0.1.0",
	"description": "Sages reward mode extension: per-workflow running score (`eval_score`) and cross-workflow trend (`eval_trend`) for the Sages agent. Default OFF, opt-in via `sages.rewardMode` in `~/.pi/agent/settings.json`.",
	"type": "module",
	"main": "src/extension.ts",
	"scripts": {
		"test": "bun test",
		"typecheck": "tsc --noEmit"
	},
	"keywords": [
		"pi",
		"pi-package",
		"sages",
		"reward-mode",
		"evaluator",
		"extension"
	],
	"license": "MIT",
	"pi": {
		"extensions": [
			"./src/extension.ts"
		],
		"skills": [
			"./skills"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-tui": "*"
	},
	"dependencies": {},
	"devDependencies": {
		"typebox": "^1.3.34",
		"@types/bun": "latest",
		"bun-types": "latest",
		"typescript": "^5.0.0"
	}
}
