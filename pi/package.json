{
  "name": "@sages/pi",
  "version": "1.0.0",
  "description": "Sages orchestrator — 4-tool DAG workflow (goal → decompose → dispatch → audit) + bash-guard + escape window.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test ./src ./test --path-ignore-patterns dist/",
    "gen:gcdb": "bun run scripts/gen-gcdb.ts",
    "verify:catalog": "bun run ../pi-orchestrator/scripts/verify-catalog.ts",
    "verify:gcdb": "bun run ../pi-orchestrator/scripts/verify-gcdb.ts",
    "verify:isolation-modes": "bun run ../pi-orchestrator/scripts/verify-isolation-modes.ts",
    "verify:namespace-ownership": "bun run ../pi-orchestrator/scripts/verify-namespace-ownership.ts",
    "verify:soft-mode-mental-model": "bun run ../pi-orchestrator/scripts/verify-soft-mode-mental-model.ts",
    "check:all": "bun run scripts/check-all.ts"
  },
  "keywords": [
    "pi-package",
    "pi",
    "agents",
    "sages",
    "four-sages",
    "roles",
    "orchestrator",
    "dag"
  ],
  "license": "MIT",
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "*",
    "@sages/pi-orchestrator": "*"
  },
  "devDependencies": {
    "@mariozechner/pi-coding-agent": "^0.70.5",
    "@types/node": "^20.19.43",
    "typescript": "^6.0.3"
  },
  "author": "vanpipy@gmail.com",
  "dependencies": {
    "bun-types": "^1.3.14",
    "js-yaml": "^5.2.0",
    "typebox": "^1.1.34"
  }
}
