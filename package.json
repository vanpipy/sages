{
  "name": "@sages/sages",
  "version": "1.0.0",
  "description": "Four Sages Agents - Multi-agent workflow for pi",
  "private": true,
  "workspaces": [
    "pi-orchestrator",
    "pi-subagents",
    "pi-codebase-memory",
    "pi-evaluator"
  ],
  "scripts": {
    "orchestrator:typecheck": "cd pi-orchestrator && bun run typecheck",
    "orchestrator:test": "cd pi-orchestrator && bun test ./test --path-ignore-patterns dist/",
    "prepare": "husky install"
  },
  "keywords": [
    "pi",
    "agents",
    "sages",
    "four-sages",
    "workflow"
  ],
  "devDependencies": {
    "husky": "^9.1.7"
  },
  "license": "MIT",
  "author": "vanpipy@gmail.com"
}
